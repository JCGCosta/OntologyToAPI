@prefix : <http://www.cedri.com/OntologyToAPI-Metadata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix comm: <http://www.cedri.com/OntologyToAPI-Communications#> .
@base <http://www.cedri.com/OntologyToAPI-Metadata#> .

:v1.0.10 rdf:type owl:Class .

: rdf:type owl:Ontology ;
           owl:versionIRI :v1.0.10 ;
           owl:imports comm:v1.0.10 ;
           dcterms:creator "https://orcid.org/0000-0002-7620-0960" ;
           dcterms:description "This ontology represent the metadata concepts from multiple data sources." ;
           dcterms:issued "2025-06-30" ;
           dcterms:modified "2026-02-21" .

#################################################################
#    Classes
#################################################################

###  http://www.cedri.com/OntologyToAPI-Metadata#Metadata
:Metadata rdf:type owl:Class ;
          rdfs:comment "The metadata of any kind of data" .


###  http://www.cedri.com/OntologyToAPI-Metadata#Source
:Source rdf:type owl:Class ;
        rdfs:comment "The source of an given data" .

#################################################################
#    Object Properties
#################################################################

###  http://www.cedri.com/OntologyToAPI-Metadata#hasCommunicationTechnology
:hasCommunicationTechnology rdf:type owl:ObjectProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :Source ;
                            rdfs:range comm:CommunicationTechnology ;
                            rdfs:comment "The metadata utilizes a communication technology to be achievable" .


###  http://www.cedri.com/OntologyToAPI-Metadata#hasSource
:hasSource rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Metadata ;
           rdfs:range :Source ;
           rdfs:comment "The metadata has some source of data" .


#################################################################
#    Data properties
#################################################################

###  http://www.cedri.com/OntologyToAPI-Metadata#hasDescription
:hasDescription rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Source ;
                rdfs:range xsd:string ;
                rdfs:comment "the description of the purpose of a query from a specific source" .


###  http://www.cedri.com/OntologyToAPI-Metadata#hasQuery
:hasQuery rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Source ;
          rdfs:range xsd:string ;
          rdfs:comment "an query to retrieve the data from a given source" .


###  http://www.cedri.com/OntologyToAPI-Metadata#hasType
:hasType rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Metadata ;
         rdfs:range xsd:string ;
         rdfs:comment "the metadata data type" .



@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_ExternalCode#> .

:v1.0.10 rdf:type owl:Class .

: rdf:type owl:Ontology ;
           owl:versionIRI :v1.0.10 ;
           dcterms:creator "https://orcid.org/0000-0002-7620-0960" ;
           dcterms:description "This ontology represent the concepts as an interface to some external piece of code." ;
           dcterms:issued "2025-06-30" ;
           dcterms:modified "2026-02-21" .

#################################################################
#    Classes
#################################################################

###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_ExternalCode#ExternalCode
:ExternalCode rdf:type owl:Class ;
              rdfs:comment "is the literal representation of a external code within a system" .

#################################################################
#    Data properties
#################################################################

###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_ExternalCode#hasFunction
:hasFunction rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :ExternalCode ;
             rdfs:range xsd:string ;
             rdfs:comment "a function name write in python" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_ExternalCode#hasPythonFile
:hasPythonFile rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :ExternalCode ;
               rdfs:range xsd:string ;
               rdfs:comment "the python file path of an external code" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_ExternalCode#requiresLib
:requiresLib rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :ExternalCode ;
             rdfs:range xsd:string ;
             rdfs:comment "the libraries required to be dynamically imported to support the external code" .



@prefix : <https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#> .

:v1.0.10 rdf:type owl:Class .

: rdf:type owl:Ontology ;
           owl:versionIRI :v1.0.10 ;
           dcterms:creator "https://orcid.org/0000-0002-7620-0960" ;
           dcterms:description "This ontology represent the communication concepts from multiple system." ;
           dcterms:issued "2025-06-30" ;
           dcterms:modified "2026-02-21" .

#################################################################
#    Classes
#################################################################

###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#APICommunication
:APICommunication rdf:type owl:Class ;
                  rdfs:subClassOf :CommunicationTechnology ;
                  rdfs:comment "A class representing API-based communication." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#DatabaseCommunication
:DatabaseCommunication rdf:type owl:Class ;
                       rdfs:subClassOf :CommunicationTechnology ;
                       rdfs:comment "A class representing communication with databases." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#FileBasedCommunication
:FileBasedCommunication rdf:type owl:Class ;
                        rdfs:subClassOf :CommunicationTechnology ;
                        rdfs:comment "A class representing communication through file systems." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#MessageQueueCommunication
:MessageQueueCommunication rdf:type owl:Class ;
                           rdfs:subClassOf :CommunicationTechnology ;
                           rdfs:comment "A class representing message broker or queue-based communication." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#RPCCommunication
:RPCCommunication rdf:type owl:Class ;
                  rdfs:subClassOf :CommunicationTechnology ;
                  rdfs:comment "A class representing Remote Procedure Call-based communication." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#ServiceMeshCommunication
:ServiceMeshCommunication rdf:type owl:Class ;
                          rdfs:subClassOf :CommunicationTechnology ;
                          rdfs:comment "A class representing service mesh-based internal service communication." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#SocketCommunication
:SocketCommunication rdf:type owl:Class ;
                     rdfs:subClassOf :CommunicationTechnology ;
                     rdfs:comment "A class representing socket-based communication." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#WebSocketCommunication
:WebSocketCommunication rdf:type owl:Class ;
                        rdfs:subClassOf :CommunicationTechnology ;
                        rdfs:comment "A class representing WebSocket communication." .


###  http://www.cedri.com/OntologyToAPI-Communications/CommunicationTechnology
:CommunicationTechnology rdf:type owl:Class ;
                           rdfs:comment "A class representing communication technology." .


#################################################################
#    Data properties
#################################################################

###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasConnectionString
:hasConnectionString rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :DatabaseCommunication ;
                     rdfs:range xsd:string ;
                     rdfs:comment "connection string for databases (e.g., SQL and non-SQL databases)" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasEndpoint
:hasEndpoint rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :APICommunication ;
             rdfs:range xsd:string ;
             rdfs:comment "has a endpoint structure to request data" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasFileType
:hasFileType rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :FileBasedCommunication ;
             rdfs:range xsd:string ;
             rdfs:comment "has a file type (e.g., XLS, XLSX, CSV, JSON, etc)" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasIPAddress
:hasIPAddress rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :CommunicationTechnology ;
              rdfs:range xsd:string ;
              rdfs:comment "the internet protocol address" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasPath
:hasPath rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :FileBasedCommunication ;
         rdfs:range xsd:string ;
         rdfs:comment "has a path for a specific file or directory" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasPort
:hasPort rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :CommunicationTechnology ;
         rdfs:range xsd:integer ;
         rdfs:comment "has default port" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasQueryCall
:hasQueryCall rdf:type owl:DatatypeProperty ;
              rdfs:domain :DatabaseCommunication ;
              rdfs:range xsd:string ;
              rdfs:comment "a generic query within any data storing technology to insert, retrieve or update information" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasQueueName
:hasQueueName rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :MessageQueueCommunication ;
              rdfs:range xsd:string ;
              rdfs:comment "has a pub/sub queue name" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasRequestURL
:hasRequestURL rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :APICommunication ;
               rdfs:range xsd:string ;
               rdfs:comment "has a request URL mainly for an API call" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasResponseField
:hasResponseField rdf:type owl:DatatypeProperty ;
                  rdfs:domain :APICommunication ;
                  rdfs:range xsd:string ;
                  rdfs:comment "has a response field in the content of message from an API call" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#hasSecurityLevel
:hasSecurityLevel rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :CommunicationTechnology ;
                  rdfs:range xsd:string ;
                  rdfs:comment "e.g., none, basic, TLS, end-to-end" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#isStateful
:isStateful rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :CommunicationTechnology ;
            rdfs:range xsd:boolean ;
            rdfs:comment "whether the communication maintains state (e.g., WebSockets = true, REST = false)." .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#usesMessageFormat
:usesMessageFormat rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :CommunicationTechnology ;
                   rdfs:range xsd:string ;
                   rdfs:comment "e.g., JSON, XML, Protobuf, Binary" .


###  https://github.com/JCGCosta/OntologyToAPI/wiki/OntologyToAPI_Communication#usesTechnology
:usesTechnology rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :DatabaseCommunication ;
                rdfs:range xsd:string ;
                rdfs:comment "the database tool (e. g. MySQL, MongoDB, MariaDB, etc.)" .

